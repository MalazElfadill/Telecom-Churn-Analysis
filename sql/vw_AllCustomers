CREATE VIEW [dbo].[vw_AllCustomers] AS
SELECT c.CustomerID, c.PlanType, c.Region, f.RechargeCountLast30Days,f.AverageMonthlySpend,  CASE 
        WHEN ch.Churned = 1 THEN 'Churned'
        WHEN ch.Churned = 0 AND (f.RechargeCountLast30Days = 0 OR comp.ComplaintCount >= 3) THEN 'At Risk'
        ELSE 'Active'
    END AS RiskStatus, comp.ComplaintCount
FROM Customers c
JOIN Finance f ON c.CustomerID = f.CustomerID
JOIN Churn ch ON c.CustomerID = ch.CustomerID
JOIN Complaints comp ON c.CustomerID = comp.CustomerID
GO


